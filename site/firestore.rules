rules_version = '2';
// Firestore security rules – Scientific Python Lab, Unit 3.
// Firebase console > Firestore Database > Rules > paste this whole file > Publish.
// To add another teacher, add the email to the list in isTeacher() (lower case) and to TEACHERS in config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isTeacher() {
      return signedIn() && request.auth.token.email_verified == true
        && myEmail() in ['poojan.shah@rru.ac.in'];
    }
    function registered() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function topicOpen(t) {
      return exists(/databases/$(database)/documents/settings/course)
        && get(/databases/$(database)/documents/settings/course).data.get('open', {}).get(t, false) == true;
    }
    function notFinal(t) {
      let p = /databases/$(database)/documents/progress/$(request.auth.uid + '__' + t);
      return !exists(p) || get(p).data.get('final', false) != true;
    }
    function rosterMatches(d) {
      let r = get(/databases/$(database)/documents/roster/$(myEmail())).data;
      return d.name == r.name && d.enrollment == r.enrollment && d.cls == r.cls && d.email == r.email;
    }

    // Topic switches (open / feedback / solutions): everyone signed in reads, only the teacher writes.
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // Class roster uploaded by the teacher. A student can read only their own entry.
    match /roster/{email} {
      allow get: if signedIn() && (email == myEmail() || isTeacher());
      allow list, create, update, delete: if isTeacher();
    }

    // Verified students. Created once by the student, copied exactly from the roster.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isTeacher();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'enrollment', 'cls', 'verifiedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == myEmail()
        && exists(/databases/$(database)/documents/roster/$(myEmail()))
        && rosterMatches(request.resource.data);
      allow update: if false;
      allow delete: if isTeacher();
    }

    // One document per student per topic: answers summary, final flag and score.
    match /progress/{id} {
      allow get: if isTeacher() || (signedIn() && id.split('__')[0] == request.auth.uid);
      allow list: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if validProgress(id);
      allow update: if isTeacher() || (validProgress(id) && resource.data.get('final', false) != true);
      allow delete: if isTeacher();
    }
    function validProgress(id) {
      let d = request.resource.data;
      return signedIn() && registered()
        && d.uid == request.auth.uid
        && id == request.auth.uid + '__' + d.topic
        && topicOpen(d.topic)
        && d.keys().hasOnly(['uid', 'topic', 'email', 'name', 'enrollment', 'cls', 'items', 'final', 'finalAt', 'score', 'total', 'updatedAt'])
        && d.items is map && d.items.size() < 500
        && d.final is bool;
    }

    // Last submitted code for each task.
    match /attempts/{id} {
      allow get: if isTeacher() || (signedIn() && id.split('__')[0] == request.auth.uid);
      allow list: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && registered()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '__' + request.resource.data.item
        && request.resource.data.keys().hasOnly(['uid', 'topic', 'item', 'ok', 'tries', 'code', 'at'])
        && request.resource.data.code is string && request.resource.data.code.size() < 20000
        && topicOpen(request.resource.data.topic)
        && notFinal(request.resource.data.topic);
      allow delete: if isTeacher();
    }
  }
}
